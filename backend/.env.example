PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rebalance?retryWrites=true&w=majority
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
# Simulator: every TICK_MS real ms, SIM_HOURS_PER_TICK hours of consumption are applied
TICK_MS=5000
SIM_HOURS_PER_TICK=1
# Prediction thresholds (hours of stock cover)
SHORTAGE_HOURS=24
SURPLUS_HOURS=96
TARGET_HOURS=48
